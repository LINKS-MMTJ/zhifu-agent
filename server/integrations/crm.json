{
  "id": "crm",
  "name": "CRM 客户关系系统",
  "baseUrl": "${CRM_BASE_URL}",
  "auth": { "type": "bearer", "tokenEnv": "CRM_TOKEN" },
  "timeoutMs": 4000,
  "retries": 1,
  "tools": [
    {
      "name": "crmCustomerProfile",
      "desc": "查询客户档案与历史工单",
      "readonly": true,
      "triggers": ["客户档案", "客户资料", "历史工单", "我的资料", "会员等级"],
      "method": "GET",
      "path": "/customers/{phone}",
      "params": {
        "phone": {
          "in": "path",
          "required": true,
          "extract": "1[3-9]\\d{9}",
          "desc": "手机号（11 位）"
        }
      }
    },
    {
      "name": "crmCreateTicket",
      "desc": "创建售后工单",
      "readonly": false,
      "triggers": ["建工单", "建个工单", "创建工单", "提工单", "提个工单", "开工单", "升级工单", "记录一下这个问题"],
      "method": "POST",
      "path": "/tickets",
      "params": {
        "phone": {
          "in": "body",
          "required": true,
          "extract": "1[3-9]\\d{9}"
        },
        "orderId": {
          "in": "body",
          "required": false,
          "extract": "SO\\d{6,}"
        },
        "subject": {
          "in": "body",
          "required": false,
          "default": "用户申请售后"
        }
      }
    }
  ]
}
