# —— 依赖与构建产物 ——
node_modules/
dist/
build/

# —— 环境变量与密钥 ——
.env
.env.local
.env.*.local
!.env.example

# —— 日志 ——
*.log
server.log
server.err.log
web.log

# —— 评测产物（体积大、可重新生成）——
server/eval/testset.json
server/eval/results.json
server/eval/judge_sample.json
server/eval/judge_prompts.json

# —— 运行期数据（会话快照、审计日志）——
# 知识索引保留入库：体积小（约 0.1MB），保证 clone 后开箱就能检索到示例语料
server/data/*
!server/data/kb/

# —— 页面上传的知识文档（属于使用者数据，不入库）——
server/knowledge/uploads/

# —— 系统与编辑器 ——
.DS_Store
Thumbs.db
.vscode/
.idea/
