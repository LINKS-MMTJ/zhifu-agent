# 复制本文件为 .env，填入真实 Key 后重启后端即可自动启用对应模型
# 后端启动命令已带 --env-file-if-exists=.env，缺少 .env 也能正常以离线 Mock 模式运行

# —— DeepSeek V4.1 Flash ——
# 申请地址：https://platform.deepseek.com/api_keys
# 官方模型名：deepseek-flash（即 DeepSeek-V4.1-Flash-1017）
# 填入后，模型注册表中的 deepseek-flash 会自动 enabled=true，被智能路由纳入候选
# 配了任意真实模型 Key 后，三个离线 Mock 模型会自动退出路由（只作为无 Key 时的兜底）
DEEPSEEK_API_KEY=
# 私有网关/代理/本地联调可覆盖接口地址（默认官方）
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# —— 阿里云百炼 / 通义千问（DashScope OpenAI 兼容模式）——
# 申请地址：https://bailian.console.aliyun.com/
# 填入后，qwen-turbo / qwen-plus / qwen-max 三档会自动启用并进入路由候选
DASHSCOPE_API_KEY=
# 海外区或私有网关可覆盖（默认国内兼容模式地址）
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 服务端口（可选，默认 4000）
PORT=4000

# —— 高并发 ——
# 单实例最大在途请求，超限返回 429
MAX_CONCURRENT=64
# 单 IP 每分钟请求上限
RATE_LIMIT_PER_MIN=600

# —— 长稳（7×24 必需）——
# 内存会话上限，超出按 LRU 淘汰
MAX_SESSIONS=5000
# 会话空闲过期（毫秒，默认 2 小时）
SESSION_TTL_MS=7200000
# 调用日志保留条数
MAX_LOGS=1000

# —— 超时与心跳 ——
# 上游模型空闲超时（毫秒）
UPSTREAM_TIMEOUT_MS=60000
# SSE 心跳间隔（毫秒）
SSE_HEARTBEAT_MS=15000
# 优雅关闭最大等待（毫秒）
SHUTDOWN_TIMEOUT_MS=15000

# —— 外部系统集成 ——
# CRM / 工单系统地址。留空则该连接器保持禁用（内置工具照常可用）
# 本地联调：启动 node bench/mockCrm.js，然后填 http://127.0.0.1:4100
CRM_BASE_URL=
CRM_TOKEN=
# 出站 webhook 签名密钥（第三方用它验签 Agent 推送的事件）
WEBHOOK_SECRET=
# 入站 webhook 验签密钥（留空则不校验签名，生产环境务必配置）
INBOUND_WEBHOOK_SECRET=
# 连接器配置目录（默认 server/integrations）
# INTEGRATIONS_DIR=

# —— 管理接口鉴权 ——
# 设置后，/api/admin/*、/api/tools 需要请求头 x-admin-token（或 Authorization: Bearer）
# 留空则放行并告警一次，仅适合内网/本地演示；公网部署务必设置
ADMIN_TOKEN=

# —— 数据持久化 ——
# 会话快照与审计日志目录，默认 server/data
# DATA_DIR=./data

# —— 知识库 ——
# 文档源目录（页面/CLI 入库都扫这个目录），默认 server/knowledge
# KB_SOURCE_DIR=./knowledge
# 索引目录，默认 server/data/kb；Docker 镜像里是 /app/kb-index
# KB_INDEX_DIR=./data/kb
# 页面单文件上传上限（MB）
# KB_MAX_UPLOAD_MB=50

# —— 成本护栏 ——
# 每日成本上限（元），0 = 不限；到软阈值自动降级为价格优先，到硬阈值拒绝新请求
DAILY_COST_LIMIT=0
DAILY_COST_SOFT_RATIO=0.8

# —— 日志 ——
# json（默认，适合日志平台）| text（本地可读）
LOG_FORMAT=json
LOG_LEVEL=info

# —— 内容安全 ——
# 逗号分隔的关键词，命中即拒绝该条消息（默认空 = 不拦截）
# 生产建议换成阿里云内容安全（Green）等文本审核服务，见 src/guard/moderation.js
MODERATION_BLOCKLIST=
