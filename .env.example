# 复制为 .env，供 docker compose 读取
# 不填也能运行：会自动使用离线 Mock 模型
# 例外：ADMIN_TOKEN 必须填（生产模式下缺失会拒绝启动）

# DeepSeek V4.1 Flash（官方模型名 deepseek-flash）
DEEPSEEK_API_KEY=

# 阿里云百炼 / 通义千问（DashScope 兼容模式）：配置后 qwen-turbo / plus / max 自动启用
DASHSCOPE_API_KEY=

# —— 必填：管理接口令牌 ——
# /api/admin/* 与 /api/tools 需要这个令牌；至少 16 位随机串
# 生成示例：node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_TOKEN=

# —— 成本护栏（可选）——
# 每日成本上限（元），0 或不填表示不限制；到 80% 自动降级为价格优先，到 100% 拒绝新请求
DAILY_COST_LIMIT=0
DAILY_COST_SOFT_RATIO=0.8

# —— 日志（可选）——
# json（默认，适合日志平台）| text（本地可读）
LOG_FORMAT=json
LOG_LEVEL=info

# —— 内容安全（可选）——
# 逗号分隔关键词，命中即拒绝；默认空 = 不拦截
MODERATION_BLOCKLIST=

# —— 外部系统集成（可选）——
# 本地联调：先在宿主机启动 node server/bench/mockCrm.js，再填 http://host.docker.internal:4100
CRM_BASE_URL=
CRM_TOKEN=
WEBHOOK_SECRET=
INBOUND_WEBHOOK_SECRET=
